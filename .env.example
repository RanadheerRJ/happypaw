# ---------------------------------------------------------------------------
# Happy Paw — environment configuration
# Copy to `.env` for local development. Only VITE_* variables reach the client.
# NEVER put the Supabase service-role key here.
# ---------------------------------------------------------------------------

# mock | supabase   (mock = in-browser fixtures, no backend; used for the Pages demo)
VITE_DATA_MODE=mock

# Shows demo logins, the dev role switcher, reset-data button and adds noindex.
VITE_DEMO_MODE=true

# Public Supabase project credentials (anon key only). Ignored in mock mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployment base path: "/" locally, "/<repo-name>/" on GitHub Pages project sites.
VITE_BASE_PATH=/

# hash | browser   (hash is the GitHub Pages default so deep links work without rewrites)
VITE_ROUTER_MODE=hash
